{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/v1.4.269/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "execution": "trusted-worker",
  "id": "tokens-dashboard",
  "name": "Tokens Dashboard",
  "version": "1.1.0",
  "description": "Local OMP and Pi token, cost and tool usage in an Orca dashboard. Reads session journals on this host.",
  "engines": { "orca": ">=1.4.269" },
  "pluginApi": 1,
  "main": "worker/main.mjs",
  "capabilities": [{ "kind": "settings:own" }],
  "contributes": {
    "customEditors": [{ "id": "dashboard", "title": "Tokens Dashboard", "extensions": [".tokens-dashboard"], "entry": "panel/index.html", "frame": "isolated" }],
    "newFiles": [{ "id": "open-dashboard", "title": "Tokens Dashboard", "extension": ".tokens-dashboard" }],
    "statusBarItems": [{ "id": "journal-status", "text": "OMP / Pi", "icon": "bar-chart-3", "tooltip": "Local OMP/Pi token history · open Tokens Dashboard from the New tab (+) menu" }],
    "settings": [
      { "key": "language", "title": "Dashboard language", "type": "string", "default": "en", "enum": ["en", "ru"], "enumLabels": ["English", "Русский"] },
      { "key": "anchor", "title": "End of chart period", "type": "string", "default": "activity", "enum": ["activity", "now"], "enumLabels": ["Last activity", "Current time"] },
      { "key": "ompDirectory", "title": "OMP sessions folder", "description": "Absolute path to OMP JSONL sessions. Blank uses ~/.omp/agent/sessions.", "type": "string", "default": "", "maxLength": 1024 },
      { "key": "piDirectory", "title": "Pi sessions folder", "description": "Absolute path to Pi JSONL sessions. Blank uses ~/.pi/agent/sessions.", "type": "string", "default": "", "maxLength": 1024 }
    ]
  }
}
